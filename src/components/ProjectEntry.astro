---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { title, blurb, date, links } = entry.data;

const display = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<li class="proj">
  <span class="title">{title}</span>
  <span class="blurb">{blurb}</span>
  <time class="date" datetime={date.toISOString().slice(0, 10)}>{display}</time>
  {(links.code || links.blog) && (
    <span class="links">
      {links.code && <a href={links.code}>Code</a>}
      {links.blog && <a href={links.blog}>Blog</a>}
    </span>
  )}
</li>

<style>
  .proj { margin-bottom: 1rem; }
  .title { display: block; font-weight: 600; }
  .blurb, .date { display: block; color: var(--color-text-muted); font-size: .9375rem; }
  .links { display: block; font-size: .875rem; }
  .links a { margin-right: .75rem; }
</style>
