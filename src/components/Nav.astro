---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/blog/', label: 'Blog' },
  { href: '/publications/', label: 'Publications' },
  { href: '/misc/', label: 'Misc' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---
<nav>
  {links.map(({ href, label }) => (
    <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
  ))}
  <ThemeToggle />
</nav>

<style>
  nav { display: flex; flex-wrap: wrap; align-items: center; gap: .25rem 1rem; }
  a[aria-current="page"] { text-decoration: underline; }
</style>
