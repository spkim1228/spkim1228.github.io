---
interface Props {
  title: string;
  authors: string[];
  venue: string;
  date: Date;
  type: 'conference' | 'workshop' | 'preprint' | 'journal' | 'thesis' | 'other';
  links: {
    pdf?: string;
    arxiv?: string;
    code?: string;
    page?: string;
    bib?: string;
  };
}

const { title, authors, venue, date, links } = Astro.props as Props;

const display = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' });
---

<li class="pub">
  <span class="title">{title}</span>
  <span class="authors">{authors.join(', ')}</span>
  <span class="venue">{venue} · <time datetime={date.toISOString().slice(0, 7)}>{display}</time></span>
  {(links.pdf || links.arxiv || links.code || links.page || links.bib) && (
    <span class="links">
      {links.pdf && <a href={links.pdf}>PDF</a>}
      {links.arxiv && <a href={links.arxiv}>arXiv</a>}
      {links.code && <a href={links.code}>Code</a>}
      {links.page && <a href={links.page}>Page</a>}
      {links.bib && <a href={links.bib}>BibTeX</a>}
    </span>
  )}
</li>

<style>
  .pub { margin-bottom: 1rem; }
  .title { display: block; font-weight: 600; }
  .authors, .venue { display: block; color: var(--color-text-muted); font-size: .9375rem; }
  .links { display: block; font-size: .875rem; }
  .links a { margin-right: .75rem; }
</style>
