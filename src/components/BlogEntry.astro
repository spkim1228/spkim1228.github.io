---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, subtitle, date, tags } = entry.data;

const href = `/blog/${entry.id}/`;
const display = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<article>
  <h3><a href={href}>{title}</a></h3>
  <p class="subtitle">{subtitle}</p>
  <time datetime={date.toISOString().slice(0, 10)}>{display}</time>
  {tags.length > 0 && <ul class="tags">{tags.map(t => <li>{t}</li>)}</ul>}
</article>

