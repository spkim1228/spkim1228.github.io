---
import Base from './Base.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	subtitle: string;
	date: Date;
}

const { title, subtitle, date } = Astro.props;

const display = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<Base title={`${title} - SPK`} description={subtitle}>
	<Header slot="header" heading={title}>
		<p class="subtitle">{subtitle}</p>
		<time datetime={date.toISOString().slice(0, 10)}>{display}</time>
	</Header>

	<article>
		<slot />
	</article>
</Base>
