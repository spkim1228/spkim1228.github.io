---
import Base from '../layouts/Base.astro';
import Navigation from '../components/Nav.astro';
import PubEntry from '../components/PubEntry.astro';

import "../styles/global.css";
import { getCollection } from 'astro:content';

const pubs = (await getCollection('publications'))
  .sort((a, b) => b.data.year - a.data.year);
const selected = pubs.filter(p => p.data.selected);
const news: { date: string; text: string }[] = [];
---

<Base
  title="Home - SPK"
  description=""
>

  <header class="intro">
    <div>
      <h1>Paul Kim</h1>
      <p>
      </p>
      <p class="contact">
        Email: spkim AT pm DOT me ·
        <a href="/cv.pdf">CV</a> ·
        <a href="https://scholar.google.com/...">Scholar</a> ·
        <a href="https://github.com/spkim1228">GitHub</a>
      </p>
    </div>

    <div>
      <Navigation />
    </div>
  </header>

  <section>

  </section>

  <section>
    <h2>News</h2>
    <ul class="news">
      {news.map(n => (
        <li><time>{n.date}</time> {n.text}</li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Selected work</h2>
    <ul class="pubs">
      {selected.map(p => <PubEntry {...p.data} />)}
    </ul>
    <a href="/publications/">All publications →</a>
  </section>
</Base>

<style>
  .intro { display: flex; gap: 1.5rem; align-items: flex-start; }
  .intro img { border-radius: 4px; }
  h1 { font-size: 1.5rem; margin: 0 0 .5rem; }
  .contact { color: #595959; font-size: .9375rem; }
  .news { list-style: none; padding: 0; }
  .news time { color: #595959; font-variant-numeric: tabular-nums; margin-right: .75rem; }
  ul.pubs { list-style: none; padding: 0; }
  section { margin-top: 2.5rem; }

  @media (max-width: 34rem) {
    .intro { flex-direction: column; }
  }
</style>
