---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';

import { Content as AboutContent, frontmatter } from '../data/about.md';

const { name, avatar, shortBio, institution } = frontmatter;
const news: { date: string; text: string }[] = [];
---

<Base
  title="Home - SPK"
  description=""
>

  <!-- Header -->
  <Header slot="header" heading={name}>
    {avatar && <img src={`/${avatar}`} alt={name} width="120" />}
    {shortBio && <p>{shortBio}</p>}
    {institution && <p class="institution">{institution}</p>}
    <ul class="contact">
      <li>Email: spkim AT pm DOT me</li>
      <li><a href="/cv.pdf">CV</a></li>
      {/* <li><a href="https://scholar.google.com/...">Scholar</a></li> */}
      <li><a href="https://github.com/spkim1228">GitHub</a></li>
    </ul>
  </Header>

  <!-- About Me -->
  <section>
    <AboutContent />
  </section>


  <!-- News -->
  <!-- <section>
    <h2>News</h2>
    <ul class="news">
      {news.map(n => (
        <li><time>{n.date}</time> {n.text}</li>
      ))}
    </ul>
  </section> -->
</Base>

<style>
  img { border-radius: 4px; }
  .institution, .contact { color: var(--color-text-muted); font-size: .9375rem; }
  .contact { display: flex; flex-wrap: wrap; list-style: none; padding: 0; }
  .contact li + li::before { content: "·"; margin: 0 .4em; }
  .news { list-style: none; padding: 0; }
  .news time { color: var(--color-text-muted); font-variant-numeric: tabular-nums; margin-right: .75rem; }
  section + section { margin-top: 2.5rem; }
</style>
